# --- AI for /search + external company synthesis (pick one; Gemini preferred if both set) ---
# Create at https://aistudio.google.com/app/apikey while signed into YOUR Google account
# GEMINI_API_KEY=AIza...
# SIGNAL_GEMINI_MODEL=gemini-flash-lite-latest
# SIGNAL_GEMINI_MAX_OUTPUT_TOKENS=1024
# SIGNAL_GEMINI_DAILY_CAP=15
# SIGNAL_GEMINI_EVIDENCE_CHARS=8000
# Optional Claude fallback:
# ANTHROPIC_API_KEY=sk-ant...
# SIGNAL_MODEL=claude-sonnet-4-20250514

# --- Continuous deal sourcing (never uses Gemini) ---
# prefill = seed corpus only (default, zero network / token cost)
# live    = EDGAR / HN / RSS / arXiv + paid stubs
# hybrid  = prefill ∪ live, deduped by company+title
# SIGNAL_SOURCING_MODE=prefill

# --- Email: M/W/F digest + immediate special-routing alerts ---
# DIGEST_ENABLED=true
# ALERTS_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=signal@thirdbase.example
# DIGEST_TO=partners@thirdbase.example
# ALERTS_TO=partners@thirdbase.example
# ALERTS_SEND_EXISTING=false
# SIGNAL_APP_BASE=http://localhost:3000
#
# Or configure recipients + SMTP in the Workbook / Digest UI
# (saved to data/config/mail.json — gitignored). Env vars win when set.

# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
